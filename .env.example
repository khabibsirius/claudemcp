# Copy to .env and edit. .env is gitignored - never commit it.

# ---------------------------------------------------------------------
# Qlik connection
# ---------------------------------------------------------------------
# "desktop"    - Qlik Sense Desktop on this machine, no auth, ws://
# "enterprise" - Qlik Sense Enterprise on-premise, certificate auth, wss://
QLIK_MODE=desktop

QLIK_HOST=localhost
# Defaults to 4848 in desktop mode, 4747 in enterprise mode.
# QLIK_PORT=4848

# App to open by default. Matched against the app's title, then its id/path,
# case-insensitively - run `python list_sheets.py --apps` to see what's there.
APP_NAME=data

# Seconds. Connect timeout guards "Qlik isn't running"; request timeout stops
# a wedged engine call from hanging the MCP server forever.
QLIK_CONNECT_TIMEOUT=10
QLIK_REQUEST_TIMEOUT=60

# ---------------------------------------------------------------------
# Enterprise on-premise only (QLIK_MODE=enterprise)
# ---------------------------------------------------------------------
# Folder holding client.pem, client_key.pem and root.pem, exported from the
# QMC: Certificates > Export certificates (choose the "Platform independent
# .pem" format). These identify which user the engine session runs as.
# QLIK_CERT_DIR=C:/qlik-certs
# QLIK_USER_DIRECTORY=YOURDOMAIN
# QLIK_USER_ID=your_user

# Verify the engine's TLS certificate against root.pem. Keep this on. Set to
# false only if you must connect by IP or by a name the cert wasn't issued
# for - it disables authentication of the server, so use it to diagnose, not
# as a permanent setting.
# QLIK_SSL_VERIFY=true

# ---------------------------------------------------------------------
# Local LLM (Ollama)
# ---------------------------------------------------------------------
# Used to design dashboards. Only needs to produce JSON, so a model with no
# tool-calling support is fine here.
OLLAMA_MODEL=phi4:14b

# Used by chat.py and web_app.py, which drive Qlik by calling tools. This
# MUST be a model with tool support - phi4 and deepseek-coder do not have it.
# Left blank it falls back to OLLAMA_MODEL, and if that can't call tools the
# app picks an installed model that can and tells you.
# Check with: ollama show <model>   (look for "tools" under capabilities)
# CHAT_MODEL=gemma3:27b

# Defaults to Ollama's own (http://127.0.0.1:11434) when left blank.
# OLLAMA_HOST=http://127.0.0.1:11434

# Seconds to wait for one model reply. Generous by default: a large
# reasoning model thinks before it answers, and a timeout that fires
# mid-generation looks exactly like a hang.
# OLLAMA_TIMEOUT=600

# Context window (tokens) requested from Ollama on every call. THE single
# most important setting for how smart the assistant seems: left unset,
# Ollama's own default is small and an oversized prompt is silently
# truncated from the front - deleting the system prompt and its rules.
# Raise as far as memory allows. 16384 suits a laptop beside Qlik; a big
# model on a dedicated server is comfortable at 32768 or 65536.
# OLLAMA_NUM_CTX=16384

# Character budget for conversation history sent to the model. Derived from
# OLLAMA_NUM_CTX when unset - set it only to override that.
# CHAT_HISTORY_CHARS=31000

# Most tool calls the assistant may make for one request. A full
# load-clean-chart flow is 15-25 calls.
# CHAT_MAX_STEPS=30


# ----------------------------------------------------------------------
# Saved conversations
# ----------------------------------------------------------------------

# Where chat history is written, one JSON file per conversation. Defaults
# to ~/.qlik-ai/history so it survives re-cloning the project and cannot be
# committed by accident. Point it anywhere you would rather keep it.
# HISTORY_DIR=C:\Users\you\.qlik-ai\history

# How many conversations to keep. The oldest are dropped past this count,
# because the sidebar reads every file to build the list. 0 keeps them all.
# HISTORY_MAX=200


# ----------------------------------------------------------------------
# Glossary
# ----------------------------------------------------------------------

# Your own definitions - what your fiscal year is, what a term means here,
# how you want figures reported - read at the start of every conversation.
# Copy glossary.example.md to glossary.md and edit it; delete the file to
# turn the feature off. Only set this to move it somewhere else.
#
# GLOSSARY_FILE=glossary.md


# ----------------------------------------------------------------------
# Which model provider
# ----------------------------------------------------------------------

# "ollama"  - a model on this machine. Nothing leaves the network, which is
#             the strongest data-protection story available.
# "openai"  - any endpoint speaking OpenAI's /v1/chat/completions: OpenAI,
#             Azure OpenAI, OpenRouter, Together, Groq, or a vLLM/TGI server
#             inside your own network. The last of those keeps the
#             data-protection story AND drops the four-minute answers.
# LLM_PROVIDER=ollama

# The API root, up to and including the version prefix.
#   OpenAI        https://api.openai.com/v1
#   OpenRouter    https://openrouter.ai/api/v1
#   vLLM / TGI    http://your-host:8000/v1
#   Azure OpenAI  https://<resource>.openai.azure.com/openai/deployments/<deployment>
# OPENAI_BASE_URL=https://api.openai.com/v1

# Leave empty for an endpoint inside your network that wants no key - an
# empty Bearer header is worse than none, so none is sent.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_ORGANISATION=

# Seconds for one reply. Generous for the same reason OLLAMA_TIMEOUT is: a
# turn with several tool calls is minutes of wall clock.
# OPENAI_TIMEOUT=600

# Whatever a particular endpoint insists on, as "Header: value" pairs
# separated by semicolons. OpenRouter asks for these two.
# OPENAI_EXTRA_HEADERS=HTTP-Referer: https://your.intranet; X-Title: Qlik AI

# Turn off only for an internal endpoint using a private CA. It stops the
# server being authenticated, so it is a decision rather than a default.
# OPENAI_VERIFY_SSL=true


# ----------------------------------------------------------------------
# Active Directory sign-in
# ----------------------------------------------------------------------

# On means people sign in with the Windows username and password they
# already use for Qlik Sense, checked against a domain controller.
#
# The reason to want it is not only the second password it removes. Their
# account here creates itself on first sign-in with the Qlik identity
# already filled in FROM AD - which is the difference between a rollout and
# an afternoon of typing user directories for three hundred people. It is
# also right, because sAMAccountName is what Qlik's own AD connector uses.
#
# Local accounts keep working alongside it, so there is always a way in when
# the directory is unreachable.
# LDAP_ENABLED=false

# LDAP_SERVER=dc01.bank.internal

# TLS is not optional: a simple bind puts the user's Windows password on the
# wire. LDAPS on 636, or StartTLS on 389. Turning both off works and logs a
# warning every time, because somebody will need it to diagnose a
# certificate problem and then forget.
# LDAP_USE_SSL=true
# LDAP_START_TLS=false
# LDAP_PORT=636

# What a typed username becomes. The UPN suffix is preferred - it works
# across a forest with several domains, where the NetBIOS name does not.
# People may type jsmith, BANK\jsmith or jsmith@bank.internal; all three work.
# LDAP_UPN_SUFFIX=bank.internal
# LDAP_WINDOWS_DOMAIN=BANK

# Where to search, and on which attribute. sAMAccountName is what Qlik's AD
# connector uses as the user id, so matching on it keeps both systems naming
# the same person the same way.
# LDAP_BASE_DN=DC=bank,DC=internal
# LDAP_USER_ATTRIBUTE=sAMAccountName

# Only needed where ordinary users may not read their own directory entry.
# Left blank, the search runs as the person who just signed in.
# LDAP_BIND_USER=BANK\svc_qlikai
# LDAP_BIND_PASSWORD=

# Members of this group administer the assistant, so joiners and leavers are
# handled where the bank already handles them. Blank leaves roles local -
# and switching it on later starts demoting anybody not in the group, which
# is deliberate but worth knowing before you set it.
# LDAP_ADMIN_GROUP=CN=Qlik AI Admins,OU=Groups,DC=bank,DC=internal

# What Qlik calls the user directory these people came from. Usually the
# NetBIOS domain, but it is the NAME OF THE QMC'S CONNECTOR rather than a
# fact about AD - get it wrong and engine sessions open as a user the QMC
# has never heard of, which surfaces as a permissions error rather than as a
# configuration one. Defaults to LDAP_WINDOWS_DOMAIN.
# LDAP_QLIK_DIRECTORY=BANK

# LDAP_TIMEOUT=10


# ----------------------------------------------------------------------
# Accounts and access
# ----------------------------------------------------------------------

# Everyone signs in, and everything below the login is per person: their own
# conversation, their own saved history, and - on Enterprise - their own Qlik
# connection, opened as them.
#
# Turn this off ONLY for a single-operator desktop install. With it off the
# server refuses to bind to anything but 127.0.0.1, because there would be no
# login in front of the figures, the load script or the reload button.
# AUTH_ENABLED=true

# The account database. Beside the chat history rather than in the project,
# so it survives re-cloning the checkout and cannot be committed by accident.
# USERS_DB=C:\Users\you\.qlik-ai\users.db

# The first administrator, created on first run when there are no accounts at
# all. Leave the password blank and one is generated and printed once at
# startup - it is not stored anywhere it can be read back, so write it down
# or set it here.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# How long a browser stays signed in.
# SESSION_HOURS=12

# Set this once the server is behind HTTPS. It cannot default to true: a
# Secure cookie is never sent over http, so the login would appear to succeed
# and every following request would arrive signed out.
# COOKIE_SECURE=false

# Password rules and lockout. The work factor is deliberately expensive and
# is paid on every login; it is set low enough to share a machine with a
# 22 GB model. Raise it on a box that is not also serving the LLM - stored
# hashes record their own cost, so old passwords keep working.
# PASSWORD_MIN=8
# PBKDF2_ROUNDS=240000
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15

# Per-user sessions to keep before looking for idle ones to close. A SOFT
# cap: only sessions idle longer than the timeout are closed, so a server
# genuinely busy with more people than this keeps them all rather than
# evicting somebody mid-question. Each session holds a Qlik socket in
# enterprise mode - an open document and a licence seat on the server.
# MAX_USER_SESSIONS=200
# USER_SESSION_IDLE_MINUTES=60


# ----------------------------------------------------------------------
# Retention
# ----------------------------------------------------------------------

# How long to keep records that are about people rather than about the
# software. Both hold customer figures by implication - a conversation
# contains whatever somebody asked about the bank's data, and the audit trail
# records who asked - so your institution will have a policy about them even
# if this software does not.
#
# 0 keeps them forever, which is the default because silently deleting a
# bank's audit trail is a worse failure than keeping too much. Enforced at
# startup and by `python manage_users.py prune`; try it first with
# `prune --dry-run`, which says what would go and deletes nothing.
# AUDIT_RETENTION_DAYS=0
# HISTORY_RETENTION_DAYS=0


# ----------------------------------------------------------------------
# Concurrency
# ----------------------------------------------------------------------

# How many requests can be in flight at once. THE setting that decides how
# many people can use this simultaneously.
#
# Every endpoint is a plain `def`, which Starlette runs in a worker thread,
# and a chat turn holds its thread for the whole turn. anyio's default pool
# is FORTY, so the forty-first concurrent chat did not queue - it blocked the
# whole server, login page included, until one finished.
#
# Size it above the number of people who might be mid-question at once, not
# above the number of accounts. 300 users of whom 30 are asking needs ~64;
# 300 genuinely simultaneous needs ~400. Threads are pooled and created on
# demand, so a high ceiling costs nothing until it is used, and the work is
# I/O-bound - a websocket to Qlik and an HTTPS call to the model.
# WORKER_THREADS=128

# Sockets the model client keeps open, shared across all users. Must be at
# least WORKER_THREADS, or turns queue on the connection pool instead of on
# the model - which looks like the model being slow.
# LLM_MAX_CONNECTIONS=200
# LLM_MAX_KEEPALIVE=50


# ----------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------

# Where the server writes its own log. Blank means the console, which is
# right while somebody is watching it and useless once it runs as a Windows
# service - a service has no console, so without this the only record of a
# problem is whatever the service wrapper happened to catch.
#
# This is the OPERATIONAL log: what the server did and what went wrong. Who
# did what is the audit trail in the accounts database, which is a different
# thing with different retention needs.
# LOG_FILE=C:\ProgramData\QlikAI\logs\qlik-ai.log
# LOG_LEVEL=INFO

# Rotation, so a long-running service cannot fill the disk.
# LOG_MAX_MB=20
# LOG_BACKUPS=10
