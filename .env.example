QLIK_MODE=desktop

QLIK_HOST=localhost

APP_NAME=data

QLIK_CONNECT_TIMEOUT=10
QLIK_REQUEST_TIMEOUT=60

OPENAI_BASE_URL=https://your-endpoint/v1
OPENAI_API_KEY=
OPENAI_MODEL=your-model-name

# ---------------------------------------------------------------------------
# Accounts from the Qlik repository (QRS)
#
# With this on, "Sync from Qlik" in the admin page (or manage_users.py sync)
# creates and refreshes accounts straight from the QMC, so every account gets
# the right Qlik identity. A blank identity is what lets one person see
# everything the service account can see, so this removes it at the source.
#
# It reuses QLIK_CERT_DIR - no new credentials.
QRS_ENABLED=false
# QRS_HOST=                       # defaults to QLIK_HOST
QRS_PORT=4242
QRS_AS_USER=INTERNAL\sa_repository
QRS_SKIP_DIRECTORIES=INTERNAL

# Who becomes an administrator here. Either a Qlik role...
QRS_ADMIN_ROLE=RootAdmin
# ...or a custom property you already keep in the QMC, which wins if set.
# QRS_ADMIN_PROPERTY=AIAccess
# QRS_ADMIN_VALUE=admin
