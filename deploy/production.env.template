# Qlik AI - production configuration
#
# Copy this to the project root as `.env` and replace every <ANGLE BRACKET>.
# Nothing else needs changing; every other setting has a working default.
#
#   Copy-Item deploy\production.env.template .env
#
# Then check your work before starting anything:
#
#   .\.venv\Scripts\python.exe check_connection.py
#
# It tests Qlik, the model endpoint, Active Directory and the accounts
# database separately, so you find out WHICH one is wrong.
#
# This file holds an API key and possibly a service-account password. Lock it
# down the way you locked down the certificates, and never commit it - it is
# gitignored, and `git ls-files .env` should stay empty.


# ======================================================================
# 1. QLIK SENSE ENTERPRISE
# ======================================================================

QLIK_MODE=enterprise

# The ENGINE hostname, and it must be the name on the certificate. Connecting
# by IP address or by an alias fails TLS verification - the certificate is
# issued to the server's name. This is the single commonest first-day
# failure.
QLIK_HOST=<qlik-engine.your-domain.internal>

# The Engine API port. Not 4848 (Desktop) and not 443 (the Qlik proxy) -
# this connects directly to the engine, bypassing the proxy.
QLIK_PORT=4747

# Folder holding client.pem, client_key.pem and root.pem, exported from the
# QMC: Certificates > Export certificates > platform independent .pem
QLIK_CERT_DIR=C:\ProgramData\QlikAI\certs

# The app everybody starts in. They can switch from the picker afterwards.
APP_NAME=<the app name>

# The service account, used for anyone with no Qlik identity of their own.
# With Active Directory sign-in below, most people will not need it - their
# identity comes from AD - but this is the fallback and it needs QMC access.
QLIK_USER_DIRECTORY=<YOURDOMAIN>
QLIK_USER_ID=<svc_qlikai>

# Keep this on. Turning it off stops the server being authenticated at all.
QLIK_SSL_VERIFY=true


# ======================================================================
# 2. THE MODEL
# ======================================================================

LLM_PROVIDER=openai

# The API root, up to and including the version prefix.
OPENAI_BASE_URL=<https://your-qwen-endpoint/v1>
OPENAI_API_KEY=<key, or leave empty if the endpoint needs none>
OPENAI_MODEL=<qwen3-max>

# Qwen3 thinks out loud before answering. The reply is cleaned either way,
# but turning it off at the endpoint is cheaper and faster than paying for
# tokens nobody reads. Both vLLM and DashScope take this; delete the line if
# your endpoint rejects it.
# OPENAI_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# Only for an endpoint inside your network using a private CA.
# OPENAI_VERIFY_SSL=true


# ======================================================================
# 3. SIGNING IN
# ======================================================================

AUTH_ENABLED=true

# Set to true ONLY once IIS is in front on HTTPS - see deploy/setup-iis.ps1.
# A Secure cookie is never sent over plain HTTP, so setting this early makes
# every login appear to succeed and every next request arrive signed out.
COOKIE_SECURE=false

# --- Active Directory --------------------------------------------------
# People sign in with the same Windows username and password they already
# type for Qlik Sense. Their account here creates itself on first sign-in,
# with the Qlik identity taken from AD - so nobody types a user directory
# three hundred times.
LDAP_ENABLED=true

LDAP_SERVER=<dc01.your-domain.internal>
LDAP_USE_SSL=true
LDAP_PORT=636

# jsmith -> jsmith@your-domain.internal
LDAP_UPN_SUFFIX=<your-domain.internal>
LDAP_WINDOWS_DOMAIN=<YOURDOMAIN>

LDAP_BASE_DN=<DC=your-domain,DC=internal>

# What the QMC calls the user directory these people came from. Usually the
# NetBIOS domain - but it is the name of the QMC's CONNECTOR, not a fact
# about AD. Get it wrong and engine sessions open as a user Qlik has never
# heard of, which surfaces as a permissions error rather than a
# configuration one. Check it in the QMC before go-live.
LDAP_QLIK_DIRECTORY=<YOURDOMAIN>

# Optional: members of this group administer the assistant, so joiners and
# leavers are handled in AD. Leave it out and roles stay local.
# LDAP_ADMIN_GROUP=<CN=Qlik AI Admins,OU=Groups,DC=your-domain,DC=internal>

# Optional: only needed if ordinary users may not read their own AD entry.
# LDAP_BIND_USER=<YOURDOMAIN\svc_qlikai>
# LDAP_BIND_PASSWORD=<password>

# --- The break-glass administrator -------------------------------------
# A LOCAL account, so somebody can still get in when a domain controller is
# unreachable. Leave the password blank and one is generated and printed
# once at first start; set it here to choose it yourself.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<choose one, or leave blank>


# ======================================================================
# 4. STATE - BACK THESE UP
# ======================================================================
# The only two things here that cannot be rebuilt from the checkout.

USERS_DB=C:\ProgramData\QlikAI\users.db
HISTORY_DIR=C:\ProgramData\QlikAI\history

# How long records about people are kept. 0 keeps them forever, which is the
# default because silently deleting a bank's audit trail is a worse failure
# than keeping too much. Set these to whatever your policy says.
AUDIT_RETENTION_DAYS=0
HISTORY_RETENTION_DAYS=0


# ======================================================================
# 5. SCALE
# ======================================================================
# The setting that decides how many people can use it at once. Every request
# holds one thread for its whole duration, and a chat turn is model latency
# plus several tool calls. Size it for people MID-QUESTION at once, not for
# the number of accounts.
#
#   300 accounts, ~30 asking at once   ->  64
#   300 accounts, ~100 asking at once  ->  192
#   300 genuinely simultaneous         ->  400
WORKER_THREADS=128

# Keep at or above WORKER_THREADS, or turns queue on the connection pool
# instead of on the model - which looks like the model being slow.
LLM_MAX_CONNECTIONS=200


# ======================================================================
# 6. STAYING UP WHEN SOMETHING ELSE GOES DOWN
# ======================================================================
# The defaults are the right answer for almost everyone. They are written
# out here so you know the behaviour exists, not because you need to change
# it.

# A dropped Qlik connection is rebuilt on the next request, but no more
# often than this. Without a limit, an unreachable Qlik means every request
# from every user starts its own connection attempt, each waiting out
# QLIK_CONNECT_TIMEOUT while holding a worker thread - which is how one
# server being down takes this one with it. Inside the window the last real
# reason is repeated instead. Pressing Reconnect on the page ignores it.
# RECONNECT_COOLDOWN_SECONDS=15

# Whether an unreachable Qlik at startup stops the server coming up. It
# should not: signing in, the admin pages, saved conversations and the audit
# trail have nothing to do with Qlik, and taking all of them away because
# one dependency is restarting turns a Qlik outage into a total one. Under a
# service manager it is also a restart loop that needs a human to end.
# Set true only where half a server is worse than none.
# REQUIRE_QLIK_AT_STARTUP=false

# Reaching the model endpoint is a different wait from waiting for it to
# think, and only the second one deserves ten minutes. A firewall that drops
# packets rather than refusing them leaves a connection attempt hanging for
# the full budget, and each of those holds a worker thread.
# OPENAI_CONNECT_TIMEOUT=10


# ======================================================================
# 7. LOGGING
# ======================================================================
# A Windows service has no console, so without this the only record of a
# problem is whatever the service wrapper caught on its way past.

LOG_FILE=C:\ProgramData\QlikAI\logs\qlik-ai.log
LOG_LEVEL=INFO
LOG_MAX_MB=20
LOG_BACKUPS=10
