AUTH_ENABLED=true

COOKIE_SECURE=false

LDAP_ENABLED=true

LDAP_SERVER=<dc01.your-domain.internal>
LDAP_USE_SSL=true
LDAP_PORT=636

LDAP_UPN_SUFFIX=<your-domain.internal>
