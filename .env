QLIK_HOST=localhost
QLIK_PORT=4848
APP_NAME=data
# 35B MoE with ~3B parameters active per token, so it answers fast even
# where it does not fully fit in VRAM - the dense 27B ran half on the CPU on
# a 12 GB card and took minutes per reply. The trade is that this build is
# Q2_K: 2-bit weights lose real accuracy, and it is an abliterated
# third-party merge rather than the official model. Judge quality on what it
# actually produces here, not on the model name.
OLLAMA_MODEL=qwen3.6:35b-a3b-mtp-q4_K_M
CHAT_MODEL=qwen3.6:35b-a3b-mtp-q4_K_M

# 16384 left no room for thinking. qwen3.6 is a reasoning model - the
# thinking sits in the context window beside the prompt, and when it does
# not fit, Ollama drops the FRONT of the prompt, which is the system prompt
# and every rule in it. The model's own limit is 262144; raise this further
# if there is memory for it, lower it if the machine starts swapping.
OLLAMA_NUM_CTX=32768


# Which model service answers: openrouter (hosted) or ollama (local).
LLM_PROVIDER=ollama

# OpenRouter. This key is a credential - .env is gitignored, keep it that way.
OPENROUTER_API_KEY=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
OPENROUTER_MODEL=qwen/qwen3.6-plus

